
import html
import os
from datetime import datetime
from urllib.parse import urlsplit

import requests
import streamlit as st


API_URL = os.getenv(
    "SOURCE_API_URL",
    "http://127.0.0.1:8001"
).rstrip("/")


st.set_page_config(
    page_title="Facebook News | SourceCredibility",
    page_icon="📰",
    layout="wide",
    initial_sidebar_state="expanded"
)


st.markdown(
    """
    <style>
