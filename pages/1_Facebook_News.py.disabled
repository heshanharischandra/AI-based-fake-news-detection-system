def card(title, content):
    st.markdown(
        (
            '<div class="fb-card">'
            '<div class="fb-card-title">'
            + html.escape(str(title))
            + '</div>'
            '<div class="fb-card-body">'
            + html.escape(str(content))
            + '</div>'
            '</div>'
        ),
        unsafe_allow_html=True
    )


def date_value(value):
    if (
        not isinstance(value, str)
        or not value.strip()
    ):
        return ""

    try:
        return datetime.fromisoformat(
            value.replace("Z", "+00:00")
        ).strftime("%Y-%m-%d · %H:%M")

    except ValueError:
        return value[:60]


language = st.selectbox(
    "Language / භාෂාව",
    ["en", "si"],
    format_func=lambda x: (
        "English" if x == "en" else "සිංහල"
    )
)

t = LANG[language]

st.markdown(
    '<div class="fb-kicker">SOURCECREDIBILITY · FACEBOOK</div>',
    unsafe_allow_html=True
)

st.markdown(
    (
        '<div class="fb-hero">'
        + html.escape(t["title"])
        + '</div>'
    ),
    unsafe_allow_html=True
)

st.markdown(
    (
        '<div class="fb-sub">'
        + html.escape(t["sub"])
        + '</div>'
    ),
    unsafe_allow_html=True
)


with st.form("facebook_input"):
    url = st.text_input(
        t["input"],
        value="",
        placeholder=t["hint"]
    )

    clicked = st.form_submit_button(
        t["button"],
        use_container_width=True,
        type="primary"
    )


if clicked:
    st.session_state.pop(
        "facebook_report",
        None
    )

    with st.spinner(t["waiting"]):
        try:
            response = requests.post(
                API_URL + "/facebook-assess",
                json={
                    "url": url.strip(),
                    "output_language": language
                },
                timeout=(5, 35)
            )

            if response.status_code == 400:
                st.error(t["invalid"])

            else:
                response.raise_for_status()

                result = response.json()

                if not isinstance(result, dict):
                    raise ValueError(
                        "Invalid JSON response"
                    )

                st.session_state[
                    "facebook_report"
                ] = result

        except (
            requests.RequestException,
            ValueError
        ) as error:
            st.error(
                f'{t["error"]} {error}'
            )


if "facebook_report" in st.session_state:
    result = st.session_state[
        "facebook_report"
    ]

    post = result.get("post") or {}
    publisher = result.get("publisher") or {}

    extraction = result.get(
        "extraction_status"
    )

    st.divider()

    st.subheader(t["post"])

    if extraction == "extracted":
        st.success(t["success"])

    elif extraction == "partial_public_metadata":
        st.warning(t["partial"])

    else:
        st.warning(t["restricted"])

    left, right = st.columns(2)

    with left:
        card(
            t["status"],
            extraction.replace("_", " ")
        )

    with right:
        card(
            t["method"],
            result.get(
                "extraction_method"
            ) or "none"
        )

    if post.get("title"):
        card(
            t["post_title"],
            post["title"]
        )

    card(
        t["post_text"],
        post.get("text") or t["no_text"]
    )

    card(
        t["date"],
        date_value(
            post.get("published_at")
        ) or t["unknown_date"]
    )

    picture = (
        post.get("image_url")
        or ""
    )

    image_host = (
        urlsplit(picture)
        .hostname or ""
    ).lower()

    if (
        picture.startswith("https://")
        and (
            image_host == "facebook.com"
            or image_host.endswith(".facebook.com")
            or image_host == "fbcdn.net"
            or image_host.endswith(".fbcdn.net")
        )
    ):
        st.subheader(t["image"])

        st.image(
            picture,
            width="stretch"
        )

    st.subheader(t["publisher"])

    if (
        publisher.get("association_status")
        == "research_dataset_candidate"
    ):
        card(
            t["candidate"],
            publisher.get("name", "")
        )

        card(
            t["review"],
            publisher.get(
                "human_review_status",
                "pending"
            )
            + " · "
            + publisher.get(
                "human_review_label",
                "unknown"
            )
        )

        website = (
            publisher.get("website_url")
            or ""
        )

        if website.startswith("https://"):
            st.link_button(
                t["website"],
                website
            )

    else:
        st.info(t["none"])

    st.subheader(t["explanation"])

    st.write(
        result.get("explanation", "")
    )

    original = result.get(
        "submitted_url",
        ""
    )

    if original.startswith("https://"):
        st.link_button(
            t["source"],
            original
        )

    st.caption(t["note"])
